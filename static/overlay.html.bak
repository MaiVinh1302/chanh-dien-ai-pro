<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chánh Điện Online 2.5D AI - Livestream Overlay</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; user-select: none; }
        html, body {
            width: 100%; height: 100%; overflow: hidden; background: #120905; color: #fff;
        }

        /* KHUNG CHÍNH CHÁNH ĐIỆN & CAMERA 3D STAGE (PHÓNG TO THU NHỎ & XOAY CÁC HƯỚNG) */
        #temple-container {
            position: relative; width: 100vw; height: 100vh; overflow: hidden;
            background-color: #0c0604;
            perspective: 1250px;
        }

        #temple-stage {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            transform-origin: 50% 65%;
            transform-style: preserve-3d;
            transition: transform 0.22s cubic-bezier(0.18, 0.89, 0.32, 1.15);
            will-change: transform;
        }

        #temple-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('/static/temple_background.jpg');
            background-size: 100% 100%; background-position: center center;
            transition: background-position 0.5s ease;
        }
        #temple-stage.is-portrait #temple-bg {
            background-position: center 35%;
        }

        #temple-canvas {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5;
        }

        /* BỘ ĐIỀU KHIỂN GÓC NHÌN & XOAY 3D TOÀN PHÒNG */
        .camera-3d-box {
            position: absolute; bottom: 85px; left: 20px; z-index: 20;
            background: rgba(18, 14, 10, 0.82); backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.35); border-radius: 16px; padding: 12px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.7); width: 205px; text-align: center;
            transition: 0.25s ease;
        }
        .cam-title {
            font-size: 11px; font-weight: bold; color: #ffd700; margin-bottom: 8px; letter-spacing: 0.5px;
        }
        .cam-orbit-grid {
            display: grid; grid-template-columns: 36px 36px 36px; grid-template-rows: 32px 32px 32px;
            gap: 4px; justify-content: center; margin: 4px auto 10px; width: 116px;
        }
        .cam-btn {
            background: rgba(255,255,255,0.06); border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 8px; color: #fff; font-size: 13px; font-weight: bold;
            display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.15s;
        }
        .cam-btn:hover { background: #d4af37; color: #000; border-color: #ffd700; transform: scale(1.08); }
        .cam-btn.center-reset { font-size: 12px; background: rgba(212, 175, 55, 0.2); color: #ffd700; }

        .cam-presets {
            display: flex; flex-wrap: wrap; gap: 4px; justify-content: center;
        }
        .preset-chip {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12);
            border-radius: 12px; padding: 3px 8px; font-size: 10px; color: #cbd5e1;
            cursor: pointer; transition: 0.15s;
        }
        .preset-chip:hover, .preset-chip.active {
            background: rgba(212, 175, 55, 0.25); border-color: #ffd700; color: #fff; font-weight: bold;
        }

        /* BỘ PHÓNG TO THU NHỎ NỔI (ZOOM CONTROLS) */
        .zoom-controls {
            display: flex; align-items: center; gap: 5px;
            background: rgba(18, 14, 10, 0.75); border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 20px; padding: 3px 8px; font-size: 11px; color: #f3e5ab;
        }
        .zoom-btn {
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
            color: #fff; width: 22px; height: 22px; border-radius: 50%; display: flex;
            align-items: center; justify-content: center; font-size: 13px; font-weight: bold;
            cursor: pointer; transition: 0.15s; outline: none;
        }
        .zoom-btn:hover { background: #d4af37; color: #000; border-color: #ffd700; }
        .zoom-val { font-weight: bold; min-width: 38px; text-align: center; cursor: pointer; color: #ffd700; }

        /* 1. THANH TRẠNG THÁI TRÊN CÙNG (GLASSMORPHISM) */
        .top-nav {
            position: absolute; top: 16px; left: 20px; right: 20px; z-index: 20;
            display: flex; justify-content: space-between; align-items: center; pointer-events: none;
        }
        .glass-pill {
            pointer-events: auto;
            background: rgba(18, 14, 10, 0.72);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.35);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            border-radius: 30px; padding: 7px 16px; font-size: 13px; font-weight: 600;
            display: flex; align-items: center; gap: 8px; color: #f3e5ab;
        }
        .live-pulse {
            width: 9px; height: 9px; background: #00e676; border-radius: 50%;
            box-shadow: 0 0 10px #00e676; animation: liveBlink 1.8s infinite;
        }
        @keyframes liveBlink { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.85); } }

        /* SỚ CẦU AN / THÔNG ĐIỆP ĐANG TỤNG NIỆM */
        .center-prayer {
            position: absolute; top: 62px; left: 50%; transform: translateX(-50%); z-index: 20;
            background: rgba(30, 15, 8, 0.85); backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 180, 50, 0.5);
            border-radius: 20px; padding: 6px 22px; font-size: 13px; font-weight: bold;
            color: #ffe082; text-shadow: 0 1px 4px rgba(0,0,0,0.8);
            box-shadow: 0 4px 16px rgba(0,0,0,0.6);
            max-width: 500px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* 2. DOCK ĐIỀU KHIỂN DƯỚI ĐÁY (CHUẨN THEO ẢNH MẪU) */
        .bottom-dock {
            position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 25;
            background: rgba(18, 14, 10, 0.75);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 36px; padding: 6px 14px;
            display: flex; align-items: center; gap: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.7);
        }
        .dock-btn {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            color: #e0e0e0; border-radius: 20px; padding: 6px 14px; font-size: 11px; font-weight: 600;
            cursor: pointer; transition: all 0.25s ease; gap: 3px; min-width: 68px;
        }
        .dock-btn:hover {
            background: rgba(212, 175, 55, 0.25); border-color: #ffd700; color: #fff; transform: translateY(-2px);
        }
        .dock-btn .dock-icon { font-size: 16px; }

        /* BẢNG XẾP HẠNG THÀNH TÂM GÓC PHẢI */
        .side-leaderboard {
            position: absolute; bottom: 85px; right: 20px; width: 230px; z-index: 20;
            background: rgba(15, 12, 10, 0.85); backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.35); border-radius: 12px; padding: 12px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.65);
        }
        .side-leaderboard h3 {
            font-size: 12px; color: #ffd700; text-align: center; letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12); padding-bottom: 6px; margin-bottom: 8px;
        }
        .lb-row {
            display: flex; justify-content: space-between; align-items: center; font-size: 11px;
            margin-bottom: 5px; color: #ddd;
        }
        .lb-row.top-1 { color: #ffd700; font-weight: bold; }
        .lb-row.top-2 { color: #e0e0e0; font-weight: bold; }
        .lb-row.top-3 { color: #cd7f32; font-weight: bold; }

        /* HỘP QUẺ LINH ỨNG (AI FORTUNE MODAL) */
        .fortune-modal {
            position: absolute; top: 46%; left: 50%; transform: translate(-50%, -50%) scale(0.7);
            width: 380px; max-width: 90%;
            background: linear-gradient(180deg, #fffdf7 0%, #f7ecd5 100%);
            border: 3px solid #8b1e0f; outline: 2px solid #d4af37;
            border-radius: 16px; padding: 20px; text-align: center; color: #3e1205;
            z-index: 60; box-shadow: 0 16px 50px rgba(0,0,0,0.9);
            opacity: 0; pointer-events: none; transition: all 0.35s cubic-bezier(0.18, 0.89, 0.32, 1.28);
        }
        .fortune-modal.active { opacity: 1; transform: translate(-50%, -50%) scale(1); pointer-events: auto; }
        .cylinder-shaking {
            font-size: 52px; display: inline-block; animation: shakeCylinder 0.22s infinite alternate;
        }
        @keyframes shakeCylinder { 0% { transform: rotate(-16deg) translateY(-4px); } 100% { transform: rotate(16deg) translateY(4px); } }
        .f-user { font-size: 13px; font-weight: bold; color: #8b1e0f; margin-bottom: 6px; }
        .f-rank {
            display: inline-block; background: #b71c1c; color: #ffd700;
            padding: 3px 14px; border-radius: 14px; font-size: 13px; font-weight: bold; margin: 6px 0;
            box-shadow: 0 2px 8px rgba(183, 28, 28, 0.4);
        }
        .f-title { font-size: 16px; font-weight: bold; color: #8b0000; margin: 6px 0 10px; }
        .f-poem {
            font-style: italic; font-size: 13px; line-height: 1.5;
            background: rgba(139, 30, 15, 0.08); padding: 10px; border-radius: 8px;
            border-left: 4px solid #b71c1c; white-space: pre-line; margin-bottom: 10px; text-align: center;
        }
        .f-meaning { font-size: 12px; font-weight: 600; color: #2e1105; line-height: 1.4; }

        /* BANNER LỄ VẬT (GIFT) */
        .gift-banner {
            position: absolute; top: 75px; left: 50%; transform: translateX(-50%) scale(0.9); z-index: 30;
            width: 440px; max-width: 90%; background: linear-gradient(90deg, #5e0b0b, #c62828, #5e0b0b);
            border: 2px solid #ffd700; border-radius: 14px; padding: 10px 16px;
            text-align: center; box-shadow: 0 8px 30px rgba(0,0,0,0.8);
            transition: all 0.35s ease; opacity: 0; pointer-events: none;
        }
        .gift-banner.active { opacity: 1; transform: translateX(-50%) scale(1); }
        .gift-banner h2 { color: #ffeb3b; font-size: 18px; text-shadow: 0 2px 4px rgba(0,0,0,0.6); }
        .gift-banner p { font-size: 13px; font-weight: bold; color: #fff; margin-top: 2px; }

        /* NÚT VÀ CỬA SỔ SETTING CONTROL PANEL */
        .setting-btn {
            background: rgba(255, 215, 0, 0.15) !important;
            border-color: rgba(212, 175, 55, 0.45) !important;
            color: #ffd700 !important;
        }
        .setting-btn:hover {
            background: rgba(212, 175, 55, 0.35) !important;
            border-color: #ffd700 !important;
            transform: translateY(-2px);
            box-shadow: 0 0 14px rgba(255, 215, 0, 0.5);
        }

        .control-modal-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 100; display: none; align-items: center; justify-content: center;
        }
        .control-modal-overlay.active {
            display: flex;
        }
        .control-modal-window {
            width: 1140px; max-width: 95vw; height: 86vh; max-height: 900px;
            background: #14161f; border: 2px solid #d4af37; border-radius: 14px;
            box-shadow: 0 16px 50px rgba(0, 0, 0, 0.95);
            display: flex; flex-direction: column; overflow: hidden;
            animation: modalPop 0.28s cubic-bezier(0.18, 0.89, 0.32, 1.28);
        }
        @keyframes modalPop {
            0% { transform: scale(0.92); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .control-modal-header {
            background: #1e202b; border-bottom: 1px solid #32364a;
            padding: 10px 18px; display: flex; justify-content: space-between; align-items: center;
        }
        .control-modal-header h3 {
            font-size: 14px; color: #ffd700; display: flex; align-items: center; gap: 8px;
        }
        .control-modal-actions {
            display: flex; gap: 8px; align-items: center;
        }
        .control-modal-btn {
            background: #2a2d3d; border: 1px solid #475569; color: #cbd5e1;
            padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: bold;
            cursor: pointer; transition: 0.2s;
        }
        .control-modal-btn:hover { background: #3b4256; color: #fff; }
        .control-close-btn {
            background: #ef4444; border: none; color: #fff;
            width: 28px; height: 28px; border-radius: 50%; display: flex;
            align-items: center; justify-content: center; font-size: 14px; font-weight: bold;
            cursor: pointer; transition: 0.2s; margin-left: 6px;
        }
        .control-close-btn:hover { background: #dc2626; transform: scale(1.1); }
        .control-modal-iframe {
            flex: 1; width: 100%; border: none; background: #12131a;
        }
    </style>
</head>
<body>

<div id="temple-container">

    <!-- THANH TRẠNG THÁI PHÍA TRÊN -->
    <div class="top-nav">
        <div class="glass-pill">
            <span class="live-pulse"></span>
            <span>CHÁNH ĐIỆN ONLINE • <span id="capacity-txt">0/32</span> Tọa vị</span>
        </div>

        <div class="glass-pill" style="gap: 10px;">
            <span>🔥 <span id="incense-count">697</span> hương &nbsp;•&nbsp; 
            ✨ <span id="merit-count">24.979</span> CĐ &nbsp;•&nbsp; 
            🪷 <span id="wf-count">2.344</span> Mõ</span>
            
            <!-- BỘ PHÓNG TO THU NHỎ GÓC NHÌN CẢ PHÒNG -->
            <div class="zoom-controls">
                <button class="zoom-btn" onclick="zoomChange(-0.15)" title="Thu nhỏ cả phòng (−)">−</button>
                <span class="zoom-val" id="zoom-txt" onclick="zoomReset()" title="Bấm để trở về 100%">100%</span>
                <button class="zoom-btn" onclick="zoomChange(0.15)" title="Phóng to cả phòng (+)">+</button>
            </div>

            <button onclick="toggleOrientation()" id="orient-top-btn" style="background: rgba(59,130,246,0.25); border: 1px solid #3b82f6; color: #93c5fd; border-radius: 14px; padding: 4px 11px; font-size: 11px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: 0.2s;" title="Chuyển đổi Ngang (16:9) / Dọc (9:16)">
                🔄 <span id="orient-txt">Ngang (16:9)</span>
            </button>
            <button onclick="openShareModal()" style="background: rgba(16,185,129,0.25); border: 1px solid #10b981; color: #34d399; border-radius: 14px; padding: 4px 11px; font-size: 11px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: 0.2s;" onmouseover="this.style.background='rgba(16,185,129,0.45)'" onmouseout="this.style.background='rgba(16,185,129,0.25)'">
                🔗 Mời Vào
            </button>
            <button onclick="openControlModal()" style="background: rgba(212,175,55,0.22); border: 1px solid #ffd700; color: #ffd700; border-radius: 14px; padding: 4px 11px; font-size: 11px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: 0.2s;" onmouseover="this.style.background='rgba(212,175,55,0.4)'" onmouseout="this.style.background='rgba(212,175,55,0.22)'">
                ⚙️ Setting
            </button>
        </div>
    </div>

    <!-- SỚ CẦU AN / BÌNH LUẬN TRUNG TÂM -->
    <div class="center-prayer" id="center-prayer">
        🙏 Nam Mô Bổn Sư Thích Ca Mâu Ni Phật • Tam Thế Tam Bảo
    </div>

    <!-- BANNER DÂNG LỄ VẬT -->
    <div class="gift-banner" id="gift-banner">
        <h2 id="gift-title">🌸 HOA SEN ĐẠI LỄ 🌸</h2>
        <p id="gift-desc">Đại Thí Chủ dâng lễ • +20 Công Đức</p>
    </div>

    <!-- CAMERA STAGE PHÓNG TO THU NHỎ & PAN (CHỨA HÌNH NỀN VÀ CANVAS) -->
    <div id="temple-stage">
        <div id="temple-bg"></div>
        <canvas id="temple-canvas"></canvas>
    </div>

    <!-- BỘ ĐIỀU KHIỂN GÓC NHÌN & XOAY 3D TOÀN PHÒNG -->
    <div class="camera-3d-box">
        <div class="cam-title">🎥 XOAY GÓC NHÌN 3D</div>
        <div class="cam-orbit-grid">
            <div></div>
            <button class="cam-btn" onclick="rotateCamera(5, 0)" title="Ngước Lên nhìn trần mái chùa">⬆️</button>
            <div></div>

            <button class="cam-btn" onclick="rotateCamera(0, -6)" title="Xoay Trái nhìn Cánh Tả">⬅️</button>
            <button class="cam-btn center-reset" onclick="resetCameraView()" title="Góc Chính Diện Toàn Cảnh">🏛️</button>
            <button class="cam-btn" onclick="rotateCamera(0, 6)" title="Xoay Phải nhìn Cánh Hữu">➡️</button>

            <div></div>
            <button class="cam-btn" onclick="rotateCamera(-5, 0)" title="Cúi Xuống nhìn sàn Bồ Đoàn">⬇️</button>
            <div></div>
        </div>
        <div class="cam-presets">
            <button class="preset-chip active" onclick="setCameraPreset('overview')">🏛️ Toàn Cảnh</button>
            <button class="preset-chip" onclick="setCameraPreset('altar')">🔍 Cận Cảnh</button>
            <button class="preset-chip" onclick="setCameraPreset('left')">👈 Cánh Tả</button>
            <button class="preset-chip" onclick="setCameraPreset('right')">👉 Cánh Hữu</button>
            <button class="preset-chip" onclick="setCameraPreset('meditate')">🧘 Thiền Vị</button>
        </div>
    </div>

    <!-- MODAL XIN QUẺ AI -->
    <div class="fortune-modal" id="fortune-modal">
        <div id="fortune-shaking-step">
            <div class="cylinder-shaking">🎋</div>
            <p style="font-weight:bold; margin-top:10px; color:#8b0000;" id="shaking-user-text">
                Đang thành tâm lắc ống xăm...
            </p>
        </div>
        <div id="fortune-result-step" style="display:none;">
            <div class="f-user" id="f-user">🙏 Thí chủ: Diệu Thảo Tâm An</div>
            <div class="f-rank" id="f-rank">THƯỢNG THƯỢNG CÁT</div>
            <div class="f-title" id="f-title">Quẻ Số 01 - Long Môn Vũ Hóa</div>
            <div class="f-poem" id="f-poem"></div>
            <div class="f-meaning" id="f-meaning"></div>
        </div>
    </div>

    <!-- BẢNG XẾP HẠNG GÓC PHẢI -->
    <div class="side-leaderboard">
        <h3>✦ TẤM LÒNG THÀNH ✦</h3>
        <div id="lb-list"></div>
    </div>

    <!-- DOCK ĐIỀU KHIỂN DƯỚI ĐÁY THEO ĐÚNG ẢNH MẪU -->
    <div class="bottom-dock">
        <!-- 3 NÚT CHÍNH CHUẨN 100% THEO ẢNH GỐC -->
        <div class="dock-btn" onclick="focusMainView()" title="Góc nhìn Chánh Điện" style="background: rgba(255,255,255,0.12); color: #fff;">
            <span class="dock-icon">🏛️</span>
            <span>Chánh Điện</span>
        </div>
        <div class="dock-btn" onclick="openShareModal()" title="Mời Phật tử / Quét QR vào Chánh Điện">
            <span class="dock-icon">👥</span>
            <span>Đạo Hữu</span>
        </div>
        <div class="dock-btn setting-btn" onclick="openControlModal()" title="Mở Bảng Điều Khiển & Kiểm Duyệt Live">
            <span class="dock-icon">⚙️</span>
            <span>Cài Đặt</span>
        </div>

        <!-- VÁCH NGĂN PHÂN CHIA TINH TẾ -->
        <div style="width: 1px; height: 24px; background: rgba(255,255,255,0.16); margin: 0 2px;"></div>

        <!-- CÁC NGHI THỨC NHANH (MÕ, CHUÔNG, QUẺ, DÂNG LỄ) -->
        <div class="dock-btn" onclick="triggerMoc()" title="Gõ Mõ">
            <span class="dock-icon">🪷</span>
            <span>Gõ Mõ</span>
        </div>
        <div class="dock-btn" onclick="triggerBell()" title="Thỉnh Chuông">
            <span class="dock-icon">🔔</span>
            <span>Chuông</span>
        </div>
        <div class="dock-btn" onclick="triggerFortune()" title="Xin Quẻ AI">
            <span class="dock-icon">🎋</span>
            <span>Xin Quẻ</span>
        </div>
        <div class="dock-btn" onclick="triggerGift()" title="Dâng Lễ Cúng Dường">
            <span class="dock-icon">🌸</span>
            <span>Dâng Lễ</span>
        </div>
        <div class="dock-btn" onclick="toggleOrientation()" title="Xoay Màn Hình Ngang / Dọc" style="background: rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.4); color: #93c5fd;">
            <span class="dock-icon">🔄</span>
            <span id="dock-orient-txt">Xoay</span>
        </div>
        <div class="dock-btn" onclick="zoomChange(0.15)" title="Phóng to cả phòng (+)" style="background: rgba(255,215,0,0.12); border-color: rgba(212,175,55,0.4); color: #ffd700;">
            <span class="dock-icon">🔍</span>
            <span id="dock-zoom-txt">100%</span>
        </div>
    </div>

    <!-- CỬA SỔ MODAL CONTROL PANEL (NHÚNG BẢNG ĐIỀU KHIỂN & KIỂM DUYỆT) -->
    <div class="control-modal-overlay" id="control-modal" onclick="handleModalOverlayClick(event)">
        <div class="control-modal-window">
            <div class="control-modal-header">
                <h3>⚙️ BẢNG ĐIỀU KHIỂN & KIỂM DUYỆT BÌNH LUẬN (CONTROL PANEL)</h3>
                <div class="control-modal-actions">
                    <button class="control-modal-btn" onclick="openControlNewTab()">↗ Mở Cửa Sổ Riêng</button>
                    <button class="control-modal-btn" onclick="refreshControlIframe()">⟳ Làm mới</button>
                    <button class="control-close-btn" onclick="closeControlModal()" title="Đóng (ESC)">✕</button>
                </div>
            </div>
            <iframe id="control-iframe" class="control-modal-iframe" src="about:blank"></iframe>
        </div>
    </div>

    <!-- MODAL CHIA SẺ & QUÉT MÃ QR TỰ ĐỘNG ĐĂNG NHẬP -->
    <div class="control-modal-overlay" id="share-modal" onclick="handleShareModalOverlayClick(event)">
        <div class="control-modal-window" style="width: 500px; height: auto; max-height: 90vh;">
            <div class="control-modal-header">
                <h3>🔗 MỜI PHẬT TỬ VÀO CHÁNH ĐIỆN TỌA THIỀN</h3>
                <div class="control-modal-actions">
                    <button class="control-close-btn" onclick="closeShareModal()" title="Đóng (ESC)">✕</button>
                </div>
            </div>
            <div style="padding: 22px; text-align: center; overflow-y: auto;">
                <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 14px;">
                    Dùng Camera điện thoại quét mã QR hoặc gửi link bên dưới để tự động bước vào Chánh Điện tọa thiền:
                </p>

                <!-- MÃ QR TẠO BẰNG CANVAS -->
                <div style="background: #ffffff; padding: 12px; border-radius: 14px; display: inline-block; box-shadow: 0 6px 25px rgba(0,0,0,0.6);">
                    <img id="qr-img" width="180" height="180" alt="QR Code" style="display: block; border-radius: 6px;">
                </div>

                <div style="margin-top: 16px;">
                    <div style="display: flex; gap: 8px;">
                        <input type="text" id="share-link-input" readonly style="flex: 1; padding: 10px 12px; background: #0c0907; border: 1px solid #d4af37; border-radius: 8px; color: #fef08a; font-size: 13px; font-weight: bold;">
                        <button onclick="copyShareLink()" id="copy-btn" style="padding: 0 18px; background: #d4af37; border: none; border-radius: 8px; font-weight: bold; color: #000; cursor: pointer; font-size: 13px; transition: 0.2s;">
                            Copy
                        </button>
                    </div>
                </div>

                <!-- CÁC LINK TỰ ĐỘNG THEO VAI TRÒ -->
                <div style="margin-top: 18px; text-align: left; background: rgba(255,255,255,0.04); padding: 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08);">
                    <div style="font-size: 12px; font-weight: bold; color: #ffd700; margin-bottom: 8px;">
                        ⚡ Link tạo sẵn theo vai trò (Bấm để copy gửi ngay):
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
                        <a href="javascript:void(0)" onclick="copyCustomLink('novice', 'Chú Tiểu')" style="color: #60a5fa; text-decoration: none;">🧘 Vào vai <b>Chú Tiểu</b> (Bấm copy link)</a>
                        <a href="javascript:void(0)" onclick="copyCustomLink('monk', 'Sư Thầy')" style="color: #f59e0b; text-decoration: none;">📿 Vào vai <b>Sư Thầy</b> (Bấm copy link)</a>
                        <a href="javascript:void(0)" onclick="copyCustomLink('nun', 'Ni Cô')" style="color: #ec4899; text-decoration: none;">🌸 Vào vai <b>Ni Cô</b> (Bấm copy link)</a>
                        <a href="javascript:void(0)" onclick="copyCustomLink('female', 'Tín Nữ')" style="color: #a78bfa; text-decoration: none;">🧕 Vào vai <b>Tín Nữ</b> (Bấm copy link)</a>
                        <a href="javascript:void(0)" onclick="copyCustomLink('high_monk', 'Cao Tăng')" style="color: #ffd700; text-decoration: none;">👑 Vào vai <b>Cao Tăng</b> (Bấm copy link)</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // =========================================================================
    // 1. ÂM THANH CHUÔNG, MÕ, ỐNG XĂM & GIỌNG ĐỌC AI TTS
    // =========================================================================
    const audioQueue = [];
    let isPlayingAudio = false;

    function enqueueAudio(base64Str) {
        if (!base64Str) return;
        if (audioQueue.length >= 12) audioQueue.shift();
        audioQueue.push(base64Str);
        processAudioQueue();
    }

    function processAudioQueue() {
        if (isPlayingAudio || audioQueue.length === 0) return;
        isPlayingAudio = true;
        const b64 = audioQueue.shift();
        playTempleBell();
        const audio = new Audio("data:audio/mp3;base64," + b64);
        audio.onended = () => { isPlayingAudio = false; processAudioQueue(); };
        audio.onerror = () => { isPlayingAudio = false; processAudioQueue(); };
        audio.play().catch(() => { isPlayingAudio = false; processAudioQueue(); });
    }

    function playTempleBell() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "sine";
            osc.frequency.setValueAtTime(528, ctx.currentTime);
            gain.gain.setValueAtTime(0.25, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.8);
            osc.connect(gain); gain.connect(ctx.destination);
            osc.start(); osc.stop(ctx.currentTime + 1.8);
        } catch (e) {}
    }

    function playWoodenFishSound() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "triangle";
            osc.frequency.setValueAtTime(580, ctx.currentTime);
            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
            osc.connect(gain); gain.connect(ctx.destination);
            osc.start(); osc.stop(ctx.currentTime + 0.1);
        } catch (e) {}
    }

    function playBambooShakeSound() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            for (let i = 0; i < 5; i++) {
                setTimeout(() => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = "triangle";
                    osc.frequency.setValueAtTime(310 + Math.random() * 90, ctx.currentTime);
                    gain.gain.setValueAtTime(0.18, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
                    osc.connect(gain); gain.connect(ctx.destination);
                    osc.start(); osc.stop(ctx.currentTime + 0.08);
                }, i * 160);
            }
        } catch (e) {}
    }

    // =========================================================================
    // 1.5 BỘ ĐIỀU KHIỂN PHÓNG TO THU NHỎ & PAN CAMERA CẢ PHÒNG (CAMERA ZOOM & PAN)
    // =========================================================================
    let cameraZoom = 1.00; // Mặc định 1.00 vừa vặn toàn cảnh Đại Điện nguy nga
    let cameraPanX = 0;
    let cameraPanY = 0;
    let cameraRotateX = 0; // Góc ngước/cúi: -15 deg (ngước lên trần mái) -> +20 deg (cúi nhìn sàn)
    let cameraRotateY = 0; // Góc xoay ngang: -28 deg (cánh tả) -> +28 deg (cánh hữu)
    let isOrbiting = false;
    let orbitStartX = 0;
    let orbitStartY = 0;
    let panDragDist = 0;

    function updateCameraTransform() {
        const stage = document.getElementById("temple-stage");
        if (stage) {
            stage.style.transform = `translate3d(${cameraPanX}px, ${cameraPanY}px, 0px) rotateX(${cameraRotateX}deg) rotateY(${cameraRotateY}deg) scale(${cameraZoom})`;
        }
        const pct = Math.round(cameraZoom * 100);
        const zTxt = document.getElementById("zoom-txt");
        if (zTxt) zTxt.innerText = `${pct}%`;
        const dTxt = document.getElementById("dock-zoom-txt");
        if (dTxt) dTxt.innerText = `${pct}%`;
    }

    function rotateCamera(deltaPitch, deltaYaw) {
        cameraRotateX = Math.min(20, Math.max(-15, cameraRotateX + deltaPitch));
        cameraRotateY = Math.min(28, Math.max(-28, cameraRotateY + deltaYaw));
        updateCameraTransform();
    }

    function resetCameraView() {
        setCameraPreset('overview');
    }

    function setCameraPreset(preset) {
        document.querySelectorAll(".preset-chip").forEach(p => p.classList.remove("active"));
        const btn = document.querySelector(`.preset-chip[onclick*="${preset}"]`);
        if (btn) btn.classList.add("active");

        if (preset === 'overview') {
            cameraZoom = 1.00;
            cameraRotateX = 0;
            cameraRotateY = 0;
            cameraPanX = 0;
            cameraPanY = 0;
            document.getElementById("center-prayer").innerText = "🏛️ Toàn Cảnh Đại Điện Tam Thế Phật • Trang Nghiêm Tự Tại";
        } else if (preset === 'altar') {
            cameraZoom = 1.45;
            cameraRotateX = 4;
            cameraRotateY = 0;
            cameraPanX = 0;
            cameraPanY = 70;
            document.getElementById("center-prayer").innerText = "🔍 Cận Cảnh Đức Phật Bổn Sư & Án Hương Linh Thiêng";
        } else if (preset === 'left') {
            cameraZoom = 1.05;
            cameraRotateX = 2;
            cameraRotateY = 18;
            cameraPanX = 70;
            cameraPanY = 20;
            document.getElementById("center-prayer").innerText = "👈 Cánh Tả Đại Điện • Hàng Cột Gỗ Lim Cổ Kính";
        } else if (preset === 'right') {
            cameraZoom = 1.05;
            cameraRotateX = 2;
            cameraRotateY = -18;
            cameraPanX = -70;
            cameraPanY = 20;
            document.getElementById("center-prayer").innerText = "👉 Cánh Hữu Đại Điện • Khung Cửa Sổ Thiền Môn";
        } else if (preset === 'meditate') {
            cameraZoom = 1.15;
            cameraRotateX = -7;
            cameraRotateY = 0;
            cameraPanX = 0;
            cameraPanY = -35;
            document.getElementById("center-prayer").innerText = "🧘 Góc Nhìn Tọa Thiền • Hướng Tâm Lên Tòa Sen";
        }
        updateCameraTransform();
        playTempleBell();
    }

    function zoomChange(delta) {
        cameraZoom = Math.min(2.5, Math.max(0.65, Math.round((cameraZoom + delta) * 100) / 100));
        updateCameraTransform();
    }

    function zoomReset() {
        setCameraPreset('overview');
    }

    // Cuộn bánh xe chuột để phóng to / thu nhỏ toàn bộ không gian Chánh Điện
    window.addEventListener("wheel", (e) => {
        if (e.target.closest("#control-modal, #share-modal, input, textarea, select")) return;
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.08 : -0.08;
        zoomChange(delta);
    }, { passive: false });

    // Kéo rê chuột tự do để Xoay hướng nhìn 3D (3D Orbit Drag)
    window.addEventListener("mousedown", (e) => {
        if (e.target.closest(".top-nav, .bottom-dock, .side-leaderboard, .camera-3d-box, .control-modal-window, button, input")) return;
        isOrbiting = true;
        orbitStartX = e.clientX;
        orbitStartY = e.clientY;
        panDragDist = 0;
    });

    window.addEventListener("mousemove", (e) => {
        if (!isOrbiting) return;
        const dx = e.clientX - orbitStartX;
        const dy = e.clientY - orbitStartY;
        orbitStartX = e.clientX;
        orbitStartY = e.clientY;
        panDragDist += Math.hypot(dx, dy);

        // Xoay hướng nhìn (Yaw & Pitch)
        cameraRotateY = Math.min(28, Math.max(-28, cameraRotateY + dx * 0.10));
        cameraRotateX = Math.min(20, Math.max(-15, cameraRotateX - dy * 0.08));

        // Dịch chuyển nhẹ khi đã phóng to
        if (cameraZoom > 1.05) {
            cameraPanX = Math.min(180, Math.max(-180, cameraPanX + dx * 0.35));
            cameraPanY = Math.min(120, Math.max(-120, cameraPanY + dy * 0.35));
        }
        updateCameraTransform();
    });

    window.addEventListener("mouseup", () => {
        isOrbiting = false;
    });

    // =========================================================================
    // 2. PHỐI CẢNH 3D, BAN THỜ TAM THẾ PHẬT & BỒ ĐOÀN ĐỆM NGỒI
    // =========================================================================
    const canvas = document.getElementById("temple-canvas");
    const ctx = canvas.getContext("2d");
    let width, height;
    let currentOrientation = "landscape"; // "landscape" (16:9) hoặc "portrait" (9:16)

    function toggleOrientation() {
        const stage = document.getElementById("temple-stage");
        if (currentOrientation === "landscape") {
            currentOrientation = "portrait";
            if (stage) stage.classList.add("is-portrait");
            document.getElementById("orient-txt").innerText = "Dọc (9:16)";
            document.getElementById("dock-orient-txt").innerText = "Dọc";
        } else {
            currentOrientation = "landscape";
            if (stage) stage.classList.remove("is-portrait");
            document.getElementById("orient-txt").innerText = "Ngang (16:9)";
            document.getElementById("dock-orient-txt").innerText = "Ngang";
        }
        buildSeatsGrid();
        playTempleBell();
    }

    function resizeCanvas() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        // Tự động nhận diện thiết bị nếu là màn hình dọc (điện thoại)
        if (width < height && currentOrientation !== "portrait") {
            currentOrientation = "portrait";
            const stage = document.getElementById("temple-stage");
            if (stage) stage.classList.add("is-portrait");
            document.getElementById("orient-txt").innerText = "Dọc (9:16)";
            document.getElementById("dock-orient-txt").innerText = "Dọc";
        }
        buildSeatsGrid();
        updateCameraTransform();
    }
    window.addEventListener("resize", resizeCanvas);

    let seats = [];
    const devotees = new Map();
    const floatingHearts = [];

    // Tạo lưới Bồ đoàn quy mô trang nghiêm chuẩn phối cảnh Đại Điện
    function buildSeatsGrid() {
        seats = [];
        const isPortrait = currentOrientation === "portrait" || (width < height);
        const rows = isPortrait ? 4 : 3;
        const colsPerSide = isPortrait ? 3 : 5;
        const vpX = width * 0.50; // Chính diện án hương Tam Thế Phật

        for (let r = 0; r < rows; r++) {
            const rowProgress = (r + 0.5) / rows;
            // Bồ đoàn tọa lạc ngay ngắn trên sàn đá từ chân án thờ khăn đỏ (0.84) xuống sát đáy (0.97)
            const y = isPortrait 
                ? height * (0.82 + rowProgress * 0.14)
                : height * (0.845 + rowProgress * 0.115);
            
            const scale = isPortrait
                ? (0.45 + rowProgress * 0.40)
                : (0.50 + rowProgress * 0.38);

            // Khoảng trống lối đi chính giữa thông thoáng (như ảnh mẫu Metaverse)
            const aisleGap = width * (isPortrait ? 0.08 : 0.075);
            const stepCol = width * (isPortrait ? 0.09 : 0.062);

            // Dãy bên Tả (bên trái án thờ)
            for (let c = 0; c < colsPerSide; c++) {
                const x = vpX - aisleGap - (c * stepCol);
                seats.push({ index: seats.length, x, y, scale, occupiedBy: null });
            }

            // Dãy bên Hữu (bên phải án thờ)
            for (let c = 0; c < colsPerSide; c++) {
                const x = vpX + aisleGap + (c * stepCol);
                seats.push({ index: seats.length, x, y, scale, occupiedBy: null });
            }
        }

        document.getElementById("capacity-txt").innerText = `${devotees.size}/${seats.length}`;

        let idx = 0;
        for (const [name, dev] of devotees.entries()) {
            if (idx < seats.length) {
                seats[idx].occupiedBy = name;
                dev.seat = seats[idx];
                dev.targetX = seats[idx].x;
                dev.targetY = seats[idx].y;
                dev.scale = seats[idx].scale;
                idx++;
            }
        }
    }

    // =========================================================================
    // 2.1 BỐ TRÍ BAN THỜ TAM THẾ PHẬT (LƯ HƯƠNG ĐỒNG, NẾN HOA, KHÓI HƯƠNG LAN TỎA)
    // =========================================================================
    const smokeParticles = [];
    function updateAndDrawSmoke(ctx, altarX, altarY) {
        if (Math.random() < 0.40) {
            smokeParticles.push({
                x: altarX + (Math.random() - 0.5) * 8,
                y: altarY - 12,
                vx: (Math.random() - 0.5) * 0.35,
                vy: -0.70 - Math.random() * 0.5,
                alpha: 0.65,
                size: 2.8 + Math.random() * 2.2,
                phase: Math.random() * Math.PI * 2
            });
        }
        for (let i = smokeParticles.length - 1; i >= 0; i--) {
            const p = smokeParticles[i];
            p.y += p.vy;
            p.phase += 0.045;
            p.x += Math.sin(p.phase) * 0.45 + p.vx;
            p.size += 0.08;
            p.alpha -= 0.0055;
            if (p.alpha <= 0) {
                smokeParticles.splice(i, 1);
            } else {
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = "#f1f5f9";
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }
    }

    let flamePhase = 0;
    function drawAltar(ctx) {
        flamePhase += 0.15;
        const isPortrait = currentOrientation === "portrait" || (width < height);
        // Tọa độ đỉnh hương trên bàn thờ khăn đỏ trung tâm
        const altarX = width * 0.50;
        const altarY = height * (isPortrait ? 0.75 : 0.725);
        const aScale = (width / 1280) * (isPortrait ? 1.05 : 0.88);

        ctx.save();
        ctx.translate(altarX, altarY);
        ctx.scale(aScale, aScale);

        // 1. LƯ HƯƠNG ĐỒNG ĐẶT CHÍNH GIỮA ÁN HƯƠNG
        ctx.fillStyle = "#c59b27";
        ctx.beginPath();
        ctx.ellipse(0, -6, 13, 7.5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#ffd700";
        ctx.lineWidth = 1;
        ctx.stroke();

        // Hai tai quai quấn hoa văn rồng mạ vàng
        ctx.strokeStyle = "#c59b27";
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.arc(-14, -7, 3.8, Math.PI * 0.5, Math.PI * 1.5);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(14, -7, 3.8, -Math.PI * 0.5, Math.PI * 0.5);
        ctx.stroke();

        // 3 nén nhang đỏ thắp trước tòa Tam Thế Phật
        ctx.strokeStyle = "#dc2626";
        ctx.lineWidth = 1.3;
        ctx.beginPath();
        ctx.moveTo(-2.8, -9); ctx.lineTo(-3.8, -24);
        ctx.moveTo(0, -10); ctx.lineTo(0, -26);
        ctx.moveTo(2.8, -9); ctx.lineTo(3.8, -24);
        ctx.stroke();

        // Đốm than đỏ hồng linh thiêng
        ctx.fillStyle = "#ff4500";
        ctx.shadowColor = "#ff4500";
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.arc(-3.8, -24, 1.2, 0, Math.PI * 2);
        ctx.arc(0, -26, 1.3, 0, Math.PI * 2);
        ctx.arc(3.8, -24, 1.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;

        // 2. NGỌN LỬA NẾN LUNG LINH TỎA ÁNH SÁNG TRÊN CẶP ĐÔN HOA SEN/CÚC VÀNG
        [-64, 64].forEach((cx, idx) => {
            const fOffset = Math.sin(flamePhase + idx * 2) * 1.0;
            const flameGrad = ctx.createRadialGradient(cx + fOffset * 0.4, -20, 1, cx, -19, 7);
            flameGrad.addColorStop(0, "#ffffff");
            flameGrad.addColorStop(0.3, "#fff176");
            flameGrad.addColorStop(0.7, "#ff9800");
            flameGrad.addColorStop(1, "rgba(239, 68, 68, 0)");

            ctx.save();
            ctx.shadowColor = "#ffb300";
            ctx.shadowBlur = 12 + Math.sin(flamePhase) * 4;
            ctx.fillStyle = flameGrad;
            ctx.beginPath();
            ctx.moveTo(cx - 2.8, -16);
            ctx.quadraticCurveTo(cx - 3.8 + fOffset, -22, cx + fOffset, -27);
            ctx.quadraticCurveTo(cx + 3.8 + fOffset, -22, cx + 2.8, -16);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        });

        ctx.restore();

        // Làn khói hương thơm trầm bay lên uyển chuyển
        updateAndDrawSmoke(ctx, altarX, altarY - 22 * aScale);
    }

    // =========================================================================
    // 2.2 VẼ TẤT CẢ BỒ ĐOÀN (ĐỆM NGỒI XÁM ĐÁ TRÊN SÀN GỖ THEO ẢNH MẪU)
    // =========================================================================
    function drawCushion(ctx, x, y, sc, isVip = false) {
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(sc, sc);

        // Đổ bóng đệm trên mặt sàn gỗ bóng
        ctx.fillStyle = "rgba(0, 0, 0, 0.45)";
        ctx.beginPath();
        ctx.roundRect(-24, 6, 48, 16, 5);
        ctx.fill();

        // Khối bồ đoàn hình chữ nhật xám đá
        ctx.fillStyle = "#33383d"; // Cạnh dưới
        ctx.beginPath();
        ctx.roundRect(-22, 0, 44, 16, 4);
        ctx.fill();

        ctx.fillStyle = "#4a5157"; // Mặt trên nệm
        ctx.beginPath();
        ctx.roundRect(-22, -4, 44, 14, 4);
        ctx.fill();

        // Viền chỉ vàng nhẹ cho VIP
        if (isVip) {
            ctx.strokeStyle = "#ffd700";
            ctx.lineWidth = 1;
            ctx.stroke();
        }
        ctx.restore();
    }

    // =========================================================================
    // 3. TẠO HÌNH NHÂN VẬT CHIBI PHẬT TỬ ĐÚNG CHUẨN THEO ẢNH
    // =========================================================================
    // Đặc trưng:
    // - Đầu trọc tròn ngộ nghĩnh (Chibi round smooth head)
    // - Áo tràng màu lam xám nhạt (#b8cbdb)
    // - Vạt áo vàng nghệ vắt qua vai (#f2b33d)
    // - Hai tư thế chính: Ngồi kiết già trên bồ đoàn hoặc Đứng chắp tay bái lạy (Anjali Mudra)
    class ChibiDevotee {
        constructor(name, message = "", isBowing = false, isVip = false) {
            this.name = name;
            this.isVip = isVip;
            this.isBowing = isBowing;
            this.state = isBowing ? "BOWING" : "MEDITATING";
            this.x = width * 0.50 + (Math.random() - 0.5) * 50;
            this.y = height + 40;
            this.seat = this.findSeat();
            this.targetX = this.seat ? this.seat.x : width * 0.5;
            this.targetY = this.seat ? this.seat.y : height * 0.85;
            this.scale = this.seat ? this.seat.scale : 0.8;
            this.bobPhase = Math.random() * Math.PI * 2;
            this.walkPhase = 0;
            this.facing = 1;
            this.bubbleText = message;
            this.bubbleTimer = message ? 240 : 0;
            this.badgeColor = isVip ? "#f59e0b" : "#10b981"; // Huy hiệu xanh ngọc hoặc vàng kim
        }

        findSeat() {
            const avail = seats.filter(s => !s.occupiedBy);
            const chosen = avail.length > 0 ? avail[Math.floor(Math.random() * avail.length)] : seats[0];
            if (chosen) chosen.occupiedBy = this.name;
            return chosen;
        }

        setSpeech(text, bow = false) {
            this.bubbleText = text;
            this.bubbleTimer = 240;
            if (bow) this.state = "BOWING";
        }

        update() {
            this.bobPhase += 0.08;
            if (this.bubbleTimer > 0) this.bubbleTimer--;

            const dx = this.targetX - this.x;
            const dy = this.targetY - this.y;
            const dist = Math.hypot(dx, dy);

            if (this.state === "WALKING") {
                this.walkPhase += 0.24;
                if (dist > 3.5) {
                    this.facing = dx >= 0 ? 1 : -1;
                    this.x += (dx / dist) * 3.8;
                    this.y += (dy / dist) * 3.8;
                } else {
                    this.x = this.targetX;
                    this.y = this.targetY;
                    this.state = "MEDITATING";
                    this.bubbleText = "Đã an tọa 🙏";
                    this.bubbleTimer = 160;
                    if (this.seat) this.seat.occupiedBy = this.name;
                }
            } else {
                if (dist > 4) {
                    this.x += (dx / dist) * 3.5;
                    this.y += (dy / dist) * 3.5;
                } else {
                    this.x = this.targetX;
                    this.y = this.targetY;
                }
            }
        }

        draw(ctx) {
            const sc = this.scale;
            const bob = this.state === "BOWING"
                ? Math.sin(this.bobPhase * 1.5) * 3
                : Math.sin(this.bobPhase) * 1.5;

            ctx.save();
            ctx.translate(this.x, this.y);

            // VẼ NHÂN VẬT CHIBI
            ctx.translate(0, -bob * sc);
            ctx.scale(sc, sc);

            if (this.state === "WALKING") {
                // TƯ THẾ BƯỚC ĐI TRONG CHÁNH ĐIỆN (WALKING ANIMATION)
                const legOffset = Math.sin(this.walkPhase) * 4.5;
                // Hai chân và giày trắng bước luân phiên
                ctx.fillStyle = "#ffffff";
                ctx.beginPath();
                ctx.ellipse(-6, 2 + legOffset, 4.5, 3, 0, 0, Math.PI * 2);
                ctx.ellipse(6, 2 - legOffset, 4.5, 3, 0, 0, Math.PI * 2);
                ctx.fill();

                // Quần lam
                ctx.fillStyle = "#9db4c4";
                ctx.fillRect(-8, -10 + legOffset * 0.4, 6, 12);
                ctx.fillRect(2, -10 - legOffset * 0.4, 6, 12);

                // Thân áo lam đung đưa theo nhịp bước
                ctx.fillStyle = "#b4cad8";
                ctx.beginPath();
                ctx.roundRect(-12, -28, 24, 20, 6);
                ctx.fill();

                // Vạt áo vàng nghệ vắt chéo
                ctx.fillStyle = "#f5ba38";
                ctx.beginPath();
                ctx.moveTo(-10, -28); ctx.lineTo(2, -28); ctx.lineTo(10, -9); ctx.lineTo(-2, -9);
                ctx.closePath();
                ctx.fill();

                // Bàn tay chắp lại
                ctx.fillStyle = "#f5cbab";
                ctx.beginPath();
                ctx.ellipse(0, -18, 4, 6, 0, 0, Math.PI * 2);
                ctx.fill();

                // Đầu tròn nhấp nhô
                const walkBob = Math.abs(Math.sin(this.walkPhase)) * 3;
                ctx.fillStyle = "#f6cdad";
                ctx.beginPath();
                ctx.arc(0, -42 - walkBob, 14, 0, Math.PI * 2);
                ctx.fill();

                ctx.beginPath();
                ctx.arc(-14, -42 - walkBob, 2.8, 0, Math.PI * 2);
                ctx.arc(14, -42 - walkBob, 2.8, 0, Math.PI * 2);
                ctx.fill();

            } else if (this.state === "BOWING") {
                // TƯ THẾ ĐỨNG CHẮP TAY BÁI LỄ (NHÂN VẬT TRUNG TÂM TRONG ẢNH)
                // Đôi chân và giày trắng
                ctx.fillStyle = "#ffffff";
                ctx.beginPath();
                ctx.ellipse(-6, 2, 4.5, 3, 0, 0, Math.PI * 2);
                ctx.ellipse(6, 2, 4.5, 3, 0, 0, Math.PI * 2);
                ctx.fill();

                // Quần lam
                ctx.fillStyle = "#9db4c4";
                ctx.fillRect(-8, -10, 6, 12);
                ctx.fillRect(2, -10, 6, 12);

                // Thân áo lam
                ctx.fillStyle = "#b4cad8";
                ctx.beginPath();
                ctx.roundRect(-12, -28, 24, 20, 6);
                ctx.fill();

                // Vạt áo vàng nghệ vắt chéo
                ctx.fillStyle = "#f5ba38";
                ctx.beginPath();
                ctx.moveTo(-10, -28);
                ctx.lineTo(2, -28);
                ctx.lineTo(10, -9);
                ctx.lineTo(-2, -9);
                ctx.closePath();
                ctx.fill();

                // Hai bàn tay chắp lại trước ngực (Anjali Mudra)
                ctx.fillStyle = "#f5cbab";
                ctx.beginPath();
                ctx.ellipse(0, -18, 4, 6, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = "#e0ad85";
                ctx.lineWidth = 1;
                ctx.stroke();

                // Đầu Chibi tròn mịn
                ctx.fillStyle = "#f6cdad";
                ctx.beginPath();
                ctx.arc(0, -42, 14, 0, Math.PI * 2);
                ctx.fill();

                // Hai tai nhỏ
                ctx.beginPath();
                ctx.arc(-14, -42, 2.8, 0, Math.PI * 2);
                ctx.arc(14, -42, 2.8, 0, Math.PI * 2);
                ctx.fill();

            } else {
                // TƯ THẾ TỌA THIỀN TRÊN BỒ ĐOÀN (NHÌN TỪ PHÍA SAU HƯỚNG VỀ PHẬT)
                // Thân áo lam kiết già
                ctx.fillStyle = "#a8bfcf";
                ctx.beginPath();
                ctx.ellipse(0, -6, 16, 10, 0, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = "#bdd1df";
                ctx.beginPath();
                ctx.roundRect(-11, -22, 22, 18, 5);
                ctx.fill();

                // Vạt áo vàng nghệ chéo qua vai
                ctx.fillStyle = "#f5ba38";
                ctx.beginPath();
                ctx.moveTo(-8, -22);
                ctx.lineTo(1, -22);
                ctx.lineTo(11, -5);
                ctx.lineTo(2, -5);
                ctx.closePath();
                ctx.fill();

                // Đầu Chibi tròn nhẵn nhìn từ sau
                const headGrad = ctx.createRadialGradient(-3, -37, 2, 0, -34, 15);
                headGrad.addColorStop(0, "#fce0c8");
                headGrad.addColorStop(1, "#f2c19c");
                ctx.fillStyle = headGrad;
                ctx.beginPath();
                ctx.arc(0, -34, 13.5, 0, Math.PI * 2);
                ctx.fill();

                // Hai tai nhỏ hai bên
                ctx.fillStyle = "#f2c19c";
                ctx.beginPath();
                ctx.arc(-13.5, -34, 2.5, 0, Math.PI * 2);
                ctx.arc(13.5, -34, 2.5, 0, Math.PI * 2);
                ctx.fill();
            }

            // 3. TAG TÊN KÍNH MỜ (FROSTED GLASS NAME BADGE THEO ẢNH MẪU)
            ctx.font = "bold 9.5px 'Segoe UI', sans-serif";
            const shortName = this.name.length > 13 ? this.name.substring(0, 12) + "…" : this.name;
            const tw = ctx.measureText(shortName).width;
            const badgeW = tw + 24;

            // Nền tag đen mờ bo tròn
            ctx.fillStyle = "rgba(18, 18, 22, 0.82)";
            ctx.beginPath();
            ctx.roundRect(-badgeW / 2, -64, badgeW, 15, 8);
            ctx.fill();
            ctx.strokeStyle = "rgba(255, 255, 255, 0.2)";
            ctx.lineWidth = 0.8;
            ctx.stroke();

            // Chấm tròn huy hiệu xanh/vàng bên trái tag
            ctx.fillStyle = this.badgeColor;
            ctx.beginPath();
            ctx.arc(-badgeW / 2 + 8, -56.5, 4.5, 0, Math.PI * 2);
            ctx.fill();

            // Chữ tên
            ctx.fillStyle = "#ffffff";
            ctx.textAlign = "left";
            ctx.fillText(shortName, -badgeW / 2 + 16, -53.5);

            // 4. BONG BÓNG THOẠI TRÊN ĐẦU
            if (this.bubbleTimer > 0 && this.bubbleText) {
                const bText = this.bubbleText.length > 25 ? this.bubbleText.substring(0, 24) + "…" : this.bubbleText;
                ctx.font = "10.5px 'Segoe UI', sans-serif";
                const bw = ctx.measureText(bText).width + 18;

                ctx.fillStyle = "rgba(22, 18, 15, 0.88)";
                ctx.beginPath();
                ctx.roundRect(-bw / 2, -92, bw, 20, 10);
                ctx.fill();
                ctx.strokeStyle = "rgba(255, 215, 0, 0.4)";
                ctx.lineWidth = 1;
                ctx.stroke();

                ctx.fillStyle = "#ffeb3b";
                ctx.textAlign = "center";
                ctx.fillText(bText, 0, -78);
            }

            ctx.restore();
        }
    }

    // =========================================================================
    // 4. ANIMATION LOOP & THẢ TIM BAY
    // =========================================================================
    function spawnOrUpdateDevotee(username, message = "", isBowing = false, isVip = false) {
        if (devotees.has(username)) {
            const dev = devotees.get(username);
            dev.setSpeech(message, isBowing);
            if (isVip) dev.isVip = true;
            return;
        }

        // Tự động giải phóng người cũ nhất nếu hết chỗ
        if (devotees.size >= seats.length) {
            const oldestKey = devotees.keys().next().value;
            const oldDev = devotees.get(oldestKey);
            if (oldDev && oldDev.seat) oldDev.seat.occupiedBy = null;
            devotees.delete(oldestKey);
        }

        const dev = new ChibiDevotee(username, message, isBowing, isVip);
        devotees.set(username, dev);
        document.getElementById("capacity-txt").innerText = `${devotees.size}/${seats.length}`;
    }

    function spawnFloatingLotus(x, y, count = 3) {
        for (let i = 0; i < count; i++) {
            floatingHearts.push({
                x: x + (Math.random() - 0.5) * 30,
                y: y - i * 10,
                vy: 1.2 + Math.random() * 0.8,
                alpha: 1.0,
                char: ["❤️", "🪷", "✨"][Math.floor(Math.random() * 3)]
            });
        }
    }

    function animate() {
        ctx.clearRect(0, 0, width, height);

        // 1. Ban thờ trang nghiêm (Lư hương khói tỏa, nến lung linh)
        drawAltar(ctx);

        // 2. Vẽ TOÀN BỘ các bồ đoàn (cushions) trên sàn trước theo phối cảnh chiều sâu
        const sortedSeats = [...seats].sort((a, b) => a.y - b.y);
        for (const s of sortedSeats) {
            drawCushion(ctx, s.x, s.y, s.scale, s.occupiedBy && devotees.get(s.occupiedBy)?.isVip);
        }

        // 3. Sắp xếp vẽ Phật tử từ trên xuống dưới theo Y để tạo chiều sâu chuẩn (Depth Sorting)
        const sorted = Array.from(devotees.values()).sort((a, b) => a.y - b.y);
        for (const dev of sorted) {
            dev.update();
            dev.draw(ctx);
        }

        // 4. Vẽ hiệu ứng hạt sen/tim bay
        for (let i = floatingHearts.length - 1; i >= 0; i--) {
            const h = floatingHearts[i];
            h.y -= h.vy;
            h.alpha -= 0.015;
            if (h.alpha <= 0) {
                floatingHearts.splice(i, 1);
            } else {
                ctx.save();
                ctx.globalAlpha = h.alpha;
                ctx.font = "18px sans-serif";
                ctx.fillText(h.char, h.x, h.y);
                ctx.restore();
            }
        }

        requestAnimationFrame(animate);
    }

    // =========================================================================
    // 5. KHỞI TẠO MẶC ĐỊNH & PHẬT TỬ MẪU (CHUẨN THEO ẢNH GỐC)
    // =========================================================================
    resizeCanvas();

    const sampleUsers = [
        ["Đại Thí Chủ Minh Tâm", "Dâng lễ hoa sen cầu an", false, true],
        ["노고만 구름", "합장으로 인사했어요", true, false], // Chú tiểu đứng bái lễ ở giữa
        ["고요한 바람", "", false, false],                 // Phật tử ngồi ngay cận cảnh trung tâm
        ["Diệu Thảo Tâm An", "", false, false],
        ["Phạm Thanh Tùng", "", false, false],
        ["Lê Hoàng Nam", "", false, false],
        ["Thỏ Con", "Nam Mô A Di Đà Phật", false, false],
        ["Ngọc Anh", "", false, false],
        ["Hằng Voka", "", false, false],
        ["Tuệ An", "", false, false],
        ["Minh Đạt", "", false, false],
        ["Diệu Hạnh", "", false, false],
        ["Quang Minh", "", false, false],
        ["Bảo Châu", "", false, false]
    ];
    sampleUsers.forEach(([name, msg, bowing, vip]) => {
        spawnOrUpdateDevotee(name, msg, bowing, vip);
    });

    animate();

    // =========================================================================
    // 6. WEBSOCKET KẾT NỐI REALTIME VỚI FASTAPI BACKEND
    // =========================================================================
    let bannerTimeout;
    function connectWS() {
        const wsProtocol = location.protocol === "https:" ? "wss:" : "ws:";
        const ws = new WebSocket(`${wsProtocol}//${location.host}/ws/overlay`);

        ws.onmessage = (event) => {
            const data = JSON.parse(event.data);
            handleIncomingLiveEvent(data);
        };

        ws.onclose = () => setTimeout(connectWS, 2000);
    }
    connectWS();

    function handleIncomingLiveEvent(data) {
        if (data.global_stats) {
            document.getElementById("incense-count").innerText = data.global_stats.incense.toLocaleString('vi-VN');
            document.getElementById("merit-count").innerText = data.global_stats.merit.toLocaleString('vi-VN');
            document.getElementById("wf-count").innerText = data.global_stats.wooden_fish.toLocaleString('vi-VN');

            const lbList = document.getElementById("lb-list");
            lbList.innerHTML = data.global_stats.leaderboard.map((item, idx) =>
                `<div class="lb-row top-${idx + 1}"><span>${idx + 1}. ${item.name.substring(0, 13)}</span><span>${item.score.toLocaleString('vi-VN')}</span></div>`
            ).join("");
        }

        if (data.type === "USER_JOINED") {
            playTempleBell();
            document.getElementById("center-prayer").innerText = `✨ Thí chủ ${data.user} vừa vào Chánh Điện tọa thiền!`;
            spawnOrUpdateDevotee(data.user, data.text || "Thành tâm đảnh lễ", true, data.is_vip);
            const dev = devotees.get(data.user);
            const px = dev ? dev.x : width * 0.5;
            const py = dev ? dev.y - 40 : height * 0.7;
            spawnFloatingLotus(px, py, 5);
        }
        else if (data.type === "BELL_RING") {
            playTempleBell();
            const dev = devotees.get(data.user);
            const px = dev ? dev.x : width * 0.5;
            const py = dev ? dev.y - 40 : height * 0.7;
            spawnFloatingLotus(px, py, 3);
        }
        else if (data.type === "LIKE") {
            playWoodenFishSound();
            const dev = devotees.get(data.user);
            const px = dev ? dev.x : width * 0.5;
            const py = dev ? dev.y - 40 : height * 0.7;
            spawnFloatingLotus(px, py, 4);
        }
        else if (data.type === "COMMENT") {
            document.getElementById("center-prayer").innerText = `🙏 ${data.user}: "${data.text}"`;
            spawnOrUpdateDevotee(data.user, data.text, true, false);
            enqueueAudio(data.audio);
        }
        else if (data.type === "FORTUNE") {
            document.getElementById("center-prayer").innerText = `🎋 ${data.user}: "${data.text}"`;
            spawnOrUpdateDevotee(data.user, "🎋 Đang xin xăm...", true, false);
            showFortuneModal(data.user, data.fortune);
            enqueueAudio(data.audio);
        }
        else if (data.type === "GIFT") {
            const banner = document.getElementById("gift-banner");
            document.getElementById("gift-title").innerText = `🌸 ${data.gift_name} 🌸`;
            document.getElementById("gift-desc").innerText = `${data.user} dâng lễ • +${data.merit_added} Công Đức`;
            banner.classList.add("active");

            clearTimeout(bannerTimeout);
            bannerTimeout = setTimeout(() => banner.classList.remove("active"), 4500);

            spawnOrUpdateDevotee(data.user, `Dâng ${data.gift_name} kinh lễ`, true, true);
            if (data.fortune) showFortuneModal(data.user, data.fortune);
            enqueueAudio(data.audio);
        }
        else if (data.type === "CAMERA_ZOOM") {
            if (data.action === "zoom_in") zoomChange(0.20);
            else if (data.action === "zoom_out") zoomChange(-0.20);
            else if (data.action === "zoom_reset") zoomReset();
        }
        else if (data.type === "DEVOTEE_MOVE") {
            const dev = devotees.get(data.user) || spawnOrUpdateDevotee(data.user, "Đang bước đi...", false, false);
            if (dev) {
                if (data.seat_index !== undefined && data.seat_index >= 0 && data.seat_index < seats.length) {
                    const targetSeat = seats[data.seat_index];
                    if (dev.seat) dev.seat.occupiedBy = null;
                    dev.seat = targetSeat;
                    targetSeat.occupiedBy = dev.name;
                    dev.targetX = targetSeat.x;
                    dev.targetY = targetSeat.y;
                    dev.scale = targetSeat.scale;
                } else if (data.direction) {
                    if (data.direction === "UP") dev.targetY = Math.max(height * 0.74, dev.y - 45);
                    else if (data.direction === "DOWN") dev.targetY = Math.min(height * 0.96, dev.y + 45);
                    else if (data.direction === "LEFT") dev.targetX = Math.max(width * 0.08, dev.x - 55);
                    else if (data.direction === "RIGHT") dev.targetX = Math.min(width * 0.92, dev.x + 55);
                    else if (data.direction === "BOW") {
                        dev.state = "BOWING";
                        dev.bubbleText = "Chắp tay đảnh lễ Tam Thế Phật 🙏";
                        dev.bubbleTimer = 220;
                        playWoodenFishSound();
                        return;
                    }
                } else if (data.target_x && data.target_y) {
                    dev.targetX = data.target_x * width;
                    dev.targetY = data.target_y * height;
                }
                dev.state = "WALKING";
                dev.bubbleText = "Đang bước tới tọa vị... 🚶";
                dev.bubbleTimer = 180;
                playWoodenFishSound();
                spawnFloatingLotus(dev.x, dev.y - 30, 2);
            }
        }
    }

    // NHẤP CHUỘT / CHẠM VÀO SÀN ĐỂ NHÂN VẬT DI CHUYỂN (CLICK-TO-MOVE)
    canvas.addEventListener("click", (e) => {
        if (panDragDist > 8) return; // Nếu vừa kéo rê góc nhìn (Pan) thì không tính là bấm bước đi

        const rect = canvas.getBoundingClientRect();
        // Ánh xạ tọa độ chuẩn xác theo tỉ lệ Zoom và Pan của camera
        const clickX = (e.clientX - rect.left) * (canvas.width / rect.width);
        const clickY = (e.clientY - rect.top) * (canvas.height / rect.height);

        // Chỉ cho phép di chuyển trên khu vực sàn đá
        if (clickY < height * 0.70) return;

        const activeDev = devotees.get("노고만 구름") || devotees.get("Diệu Thảo Tâm An") || Array.from(devotees.values())[0];
        if (activeDev) {
            let nearestSeat = null;
            let minDist = 9999;
            seats.forEach((s) => {
                const d = Math.hypot(s.x - clickX, s.y - clickY);
                if (d < minDist) { minDist = d; nearestSeat = s; }
            });

            if (nearestSeat && minDist < 65) {
                if (activeDev.seat) activeDev.seat.occupiedBy = null;
                activeDev.seat = nearestSeat;
                nearestSeat.occupiedBy = activeDev.name;
                activeDev.targetX = nearestSeat.x;
                activeDev.targetY = nearestSeat.y;
                activeDev.scale = nearestSeat.scale;
            } else {
                activeDev.targetX = clickX;
                activeDev.targetY = clickY;
            }
            activeDev.state = "WALKING";
            activeDev.bubbleText = "Đang bước đi... 🚶";
            activeDev.bubbleTimer = 180;
            playWoodenFishSound();
            spawnFloatingLotus(clickX, clickY, 3);
        }
    });

    function showFortuneModal(user, fortune) {
        const modal = document.getElementById("fortune-modal");
        const shakeStep = document.getElementById("fortune-shaking-step");
        const resultStep = document.getElementById("fortune-result-step");

        shakeStep.style.display = "block";
        resultStep.style.display = "none";
        document.getElementById("shaking-user-text").innerText = `Thí chủ ${user} đang lắc ống xăm...`;
        modal.classList.add("active");
        playBambooShakeSound();

        setTimeout(() => {
            shakeStep.style.display = "none";
            resultStep.style.display = "block";
            document.getElementById("f-user").innerText = `🙏 Thí chủ: ${user}`;
            document.getElementById("f-rank").innerText = fortune.rank;
            document.getElementById("f-title").innerText = `${fortune.id}: ${fortune.title}`;
            document.getElementById("f-poem").innerText = fortune.poem;
            document.getElementById("f-meaning").innerText = `💡 Lời bàn: ${fortune.meaning}`;
        }, 1300);

        setTimeout(() => {
            modal.classList.remove("active");
        }, 7000);
    }

    // =========================================================================
    // 7. CÁC NÚT DOCK TEST NHANH TRÊN MÀN HÌNH
    // =========================================================================
    function focusMainView() {
        playTempleBell();
        document.getElementById("center-prayer").innerText = "🏛️ Chánh Điện trang nghiêm • Thân tâm an tịnh";
        spawnFloatingLotus(width * 0.44, height * 0.58, 4);
    }
    function triggerMoc() {
        playWoodenFishSound();
        spawnFloatingLotus(width * 0.5, height * 0.7, 3);
    }
    function triggerBell() {
        playTempleBell();
    }
    function triggerFortune() {
        fetch("/api/simulate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                platform: "tiktok",
                event_type: "FORTUNE",
                user: "Thí Chủ Diệu Thảo",
                text: "Xin quẻ cầu an gia đạo hanh thông"
            })
        });
    }
    function triggerGift() {
        fetch("/api/simulate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                platform: "tiktok",
                event_type: "GIFT",
                user: "Đại Thí Chủ",
                gift_name: "HOA SEN VÀNG",
                diamonds: 5
            })
        });
    }

    // =========================================================================
    // 8. ĐIỀU KHIỂN CỬA SỔ SETTING (CONTROL PANEL POPUP)
    // =========================================================================
    function openControlModal() {
        const modal = document.getElementById("control-modal");
        const iframe = document.getElementById("control-iframe");
        if (!iframe.src || iframe.src.includes("about:blank")) {
            iframe.src = "/control";
        }
        modal.classList.add("active");
    }

    function closeControlModal() {
        const modal = document.getElementById("control-modal");
        modal.classList.remove("active");
    }

    function handleModalOverlayClick(e) {
        if (e.target.id === "control-modal") {
            closeControlModal();
        }
    }

    function openControlNewTab() {
        window.open('/control', 'ChanhDienControl', 'width=1140,height=850,menubar=no,toolbar=no,status=no');
    }

    function refreshControlIframe() {
        const iframe = document.getElementById("control-iframe");
        iframe.src = "/control";
    }

    // Cho phép bấm phím ESC để đóng nhanh Setting hoặc Share modal
    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            closeControlModal();
            closeShareModal();
        }
    });

    // =========================================================================
    // 9. ĐIỀU KHIỂN CỬA SỔ CHIA SẺ & MÃ QR (SHARE MODAL)
    // =========================================================================
    function getShareBaseUrl() {
        return window.location.origin;
    }

    function openShareModal() {
        const modal = document.getElementById("share-modal");
        const joinUrl = `${getShareBaseUrl()}/join`;
        document.getElementById("share-link-input").value = joinUrl;
        
        // Sinh mã QR nhanh qua API QR chuẩn
        const qrImg = document.getElementById("qr-img");
        qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(joinUrl)}`;
        
        modal.classList.add("active");
    }

    function closeShareModal() {
        const modal = document.getElementById("share-modal");
        modal.classList.remove("active");
    }

    function handleShareModalOverlayClick(e) {
        if (e.target.id === "share-modal") {
            closeShareModal();
        }
    }

    function copyShareLink() {
        const input = document.getElementById("share-link-input");
        input.select();
        navigator.clipboard.writeText(input.value);
        const btn = document.getElementById("copy-btn");
        btn.innerText = "✓ Đã Chép";
        btn.style.background = "#10b981";
        setTimeout(() => {
            btn.innerText = "Copy";
            btn.style.background = "#d4af37";
        }, 2000);
    }

    function copyCustomLink(avatar, roleName) {
        const url = `${getShareBaseUrl()}/join?auto=1&avatar=${avatar}&name=${encodeURIComponent(roleName)}`;
        navigator.clipboard.writeText(url);
        const btn = document.getElementById("copy-btn");
        const input = document.getElementById("share-link-input");
        input.value = url;
        btn.innerText = "✓ Đã Chép";
        btn.style.background = "#10b981";
        setTimeout(() => {
            btn.innerText = "Copy";
            btn.style.background = "#d4af37";
        }, 2000);
    }
</script>
</body>
</html>
